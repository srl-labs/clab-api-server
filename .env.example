# .env.example
API_PORT=8090
API_SERVER_HOST=localhost
JWT_SECRET=a_very_secret_key_change_me_please # CHANGE THIS! Use a strong, random secret
JWT_EXPIRATION=24h
API_USER_GROUP=clab_api # The API group name, if not defined, the user needs to be in clab_admins group
SUPERUSER_GROUP=clab_admins # The Superusers are allowed to see all labs
CLAB_RUNTIME=docker # The runtime to use for the labs: docker, podman or c9s (Kubernetes through clabernetes)
CLAB_LABS_ROOT= # Optional absolute root for managed lab workspaces, e.g. /var/lib/containerlab/labs
CLAB_SHARED_LABS_ROOT= # Optional absolute folder shared by all authenticated API users, exposed as @shared/
CLAB_HOSTS_FILE= # Optional host-visible hosts file when the API server runs in a container
CLAB_RESTORE_STAGING_DIR=/var/lib/clab-api-server/restore # Server-owned folder for snapshots mounted by restored nodes
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=https://localhost:5173 # Comma-separated list, e.g. https://localhost:5173,https://ui.example.com

# Gin Settings
GIN_MODE=release       # Options: debug, release, test
TRUSTED_PROXIES=     # Options: nil (trust none), comma-separated IPs, or empty (trust all)

# SSH proxy port range (Default: 2223-2322)
#SSH_BASE_PORT=2223
#SSH_MAX_PORT=2322

# Browser terminal sessions
#TERMINAL_MAX_SESSIONS_PER_USER=128
# A resumable browser terminal keeps running this long after its last client left;
# other terminals end when their client leaves
#TERMINAL_IDLE_TIMEOUT=30m

# --- Kubernetes (CLAB_RUNTIME=c9s) ---
# Cluster connection; empty uses KUBECONFIG, ~/.kube/config or, in a Pod, the in-cluster ServiceAccount
#CLAB_KUBECONFIG=/etc/clab-api-server/kubeconfig
#CLAB_KUBE_CONTEXT=
# One namespace for every lab (namespace mode "fixed"); empty gives every lab its own namespace c9s-<lab>
#CLAB_KUBE_NAMESPACE=
# Service type of lab nodes: None (clients reach nodes through the server), ClusterIP, Headless or LoadBalancer
#CLAB_C9S_EXPOSE_TYPE=None
# Keep node storage (saved configuration) across Pod replacement and a plain destroy
#CLAB_C9S_PERSISTENCE=true
# Docker-config Secret device Pods pull images with
#CLAB_C9S_IMAGE_PULL_SECRET=

# --- TLS Configuration ---
TLS_ENABLE=true
TLS_AUTO_CERT=true # Generate/reuse a local self-signed certificate when cert/key files are unset
#TLS_CERT_FILE=./certs/localhost+2.pem # Path relative to where you run the app
#TLS_KEY_FILE=./certs/localhost+2-key.pem # Path relative to where you run the app
