# .env.example
API_PORT=8090
# Network address to bind. Use 0.0.0.0 only when remote/container access is intended.
API_LISTEN_ADDRESS=127.0.0.1
API_SERVER_HOST=localhost
JWT_SECRET=a_very_secret_key_change_me_please # REQUIRED: replace this placeholder with at least 32 random characters
JWT_EXPIRATION=24h
API_USER_GROUP=clab_api # Group whose members receive basic API access
SUPERUSER_GROUP=clab_admins # The Superusers are allowed to see all labs
CLAB_RUNTIME=docker # The runtime to use for the labs
CLAB_LABS_ROOT= # Optional absolute root for managed lab workspaces, e.g. /var/lib/containerlab/labs
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=https://localhost:5173 # Comma-separated list, e.g. https://localhost:5173,https://ui.example.com

# Gin Settings
GIN_MODE=release       # Options: debug, release, test
TRUSTED_PROXIES=     # Options: nil (trust none), comma-separated IPs, or empty (trust all)

# SSH proxy port range (Default: 2223-2322)
#SSH_BASE_PORT=2223
#SSH_MAX_PORT=2322

# Browser terminal sessions
#TERMINAL_MAX_SESSIONS_PER_USER=128

# --- TLS Configuration ---
TLS_ENABLE=true
TLS_AUTO_CERT=true # Generate/reuse a local self-signed certificate when cert/key files are unset
#TLS_CERT_FILE=./certs/localhost+2.pem # Path relative to where you run the app
#TLS_KEY_FILE=./certs/localhost+2-key.pem # Path relative to where you run the app
